<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>H3TVR</AssemblyName>
    <RootNamespace>H3TVR</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(USERPROFILE)\Downloads\</OutputPath>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>false</IncludeSymbols>
    <DefineConstants>H3TVR_PLUGIN</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RuntimeIdentifiers>win;win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier>win</RuntimeIdentifier>
    <SkipValidateGameAssemblies Condition=" '$(SkipValidateGameAssemblies)' == '' ">false</SkipValidateGameAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <InformationalVersion>1.2.0</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <UnityManagedDir Condition=" '$(UnityManagedDir)' == '' ">C:\Program Files (x86)\Steam\steamapps\common\H3VR\h3vr_Data\Managed</UnityManagedDir>
    <BepInExDir Condition=" '$(BepInExDir)' == '' ">$(UnityManagedDir)</BepInExDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core Improved Architecture -->
    <Compile Include="H3TVRImproved.cs" />
    <Compile Include="InputHandler.cs" />
    <Compile Include="SpawnManager.cs" />
    <Compile Include="EffectsManager.cs" />
    <Compile Include="WeaponManager.cs" />
    
    <!-- Core Components -->
    <Compile Include="PluginInfo.cs" />
    <Compile Include="SlomoMovementController.cs" />
    <Compile Include="Hooks.cs" />
    
    <!-- Note: Sosig files temporarily commented out for compilation -->
    <!-- 
    <Compile Include="SosigSpawnerIntegration.cs" />
    <Compile Include="SosigSpawnerManager.cs" />
    <Compile Include="SosigWeaponManager.cs" />
    <Compile Include="SosigLoadoutConfiguration.cs" />
    <Compile Include="SosigLoadoutUtility.cs" />
    <Compile Include="SosigStatsManager.cs" />
    <Compile Include="SosigPerformanceMonitor2.cs" />
    <Compile Include="SosigScenarioManager.cs" />
    
    <Compile Include="H3VRAssetLoader.cs" />
    <Compile Include="H3VRDelayedInitializer.cs" />
    <Compile Include="H3VRAssetLoadingTest.cs" />
    -->
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine" Condition="Exists('$(UnityManagedDir)\UnityEngine.dll')">
      <HintPath>$(UnityManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Condition="Exists('$(UnityManagedDir)\UnityEngine.CoreModule.dll')">
      <HintPath>$(UnityManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule" Condition="Exists('$(UnityManagedDir)\UnityEngine.IMGUIModule.dll')">
      <HintPath>$(UnityManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI" Condition="Exists('$(UnityManagedDir)\UnityEngine.UI.dll')">
      <HintPath>$(UnityManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp" Condition="Exists('$(UnityManagedDir)\Assembly-CSharp.dll')">
      <HintPath>$(UnityManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FistVR" Condition="Exists('$(UnityManagedDir)\FistVR.dll')">
      <HintPath>$(UnityManagedDir)\FistVR.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sodalite" Condition="Exists('$(UnityManagedDir)\Sodalite.dll')">
      <HintPath>$(UnityManagedDir)\Sodalite.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx" Condition="Exists('$(BepInExDir)\BepInEx.dll')">
      <HintPath>$(BepInExDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony" Condition="Exists('$(BepInExDir)\0Harmony.dll')">
      <HintPath>$(BepInExDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateGameAssemblies" BeforeTargets="CoreCompile" Condition=" '$(SkipValidateGameAssemblies)' != 'true' ">
    <Message Importance="high" Text="Using Unity Managed Dir: $(UnityManagedDir)" />
    <Error Condition="!Exists('$(UnityManagedDir)\Assembly-CSharp.dll')" Text="Could not find Assembly-CSharp.dll. Set UnityManagedDir property to your H3VR h3vr_Data\Managed folder." />
    <Warning Condition="!Exists('$(UnityManagedDir)\FistVR.dll')" Text="Could not find FistVR.dll. Gameplay-specific types will fail at runtime." />
  </Target>

  <Target Name="PostBuild" AfterTargets="Build">
    <Message Text="Built plugin: $(TargetPath)" Importance="high" />
  </Target>
</Project>